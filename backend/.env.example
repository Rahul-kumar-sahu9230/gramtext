# --- Gemini (OCR) ---
GEMINI_API_KEY=
# Flash-Lite answers in ~2 s; Flash with default thinking took ~17 s.
GEMINI_MODEL=gemini-flash-lite-latest
# Tried in order only if the main model returns "not found".
# Add other IDs only if AI Studio lists them for your key.
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.8-flash
# OCR needs no reasoning: "low" keeps it fast (leave empty for the model default)
GEMINI_THINKING=low

# --- Our STR model (ml/export.py writes models/gramtext_str.pt) ---
# auto = our model first, Gemini when unsure | str = our model only | gemini = Gemini only
OCR_ENGINE=auto
STR_MODEL_PATH=models/gramtext_str.pt
# Below this average character confidence, Gemini double-checks the result
STR_MIN_CONFIDENCE=0.85

# --- Field-pilot metrics (SQLite, no images or scanned text stored) ---
DB_PATH=data/gramtext.db

# --- Text-to-speech (gTTS, Google Translate voices, no key needed) ---
# Hindi text is read with lang=hi, English with lang=en (mixed text uses both).
# co.in = Indian English accent
TTS_TLD=co.in
# true = slower speech for low-literacy users
TTS_SLOW=false

# --- App limits ---
MAX_UPLOAD_MB=10
TTS_MAX_CHARS=1500
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
